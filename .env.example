# Copy to .env and fill in keys from your NEW Alpaca *paper* account.
# Paper keys start with "PK". The bot refuses to run with live keys ("AK...").
ALPACA_API_KEY=PKXXXXXXXXXXXXXXXXXX
ALPACA_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Name and contact email sent to sec.gov and bls.gov (their fair-access rules require it)
SEC_USER_AGENT="PatternTrader you@example.com"

# Free data keys (scripts/set-data-keys.sh)
ALPHAVANTAGE_API_KEY=
FRED_API_KEY=
